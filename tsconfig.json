{
  // Node project: server-side sources, their tests and the tooling config files.
  // Used by `npm run typecheck`, ESLint and editors. Browser code under src/web/ gets its own
  // tsconfig (DOM lib, no Node types) and is excluded here.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "types": ["node"],
    "noEmit": true,
    // Type-check the JavaScript config files too (eslint.config.js).
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*.ts", "*.config.ts", "*.config.js"],
  "exclude": ["src/web/**"]
}
