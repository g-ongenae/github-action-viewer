{
  // Emits the Node sources to dist/ (tests, test fixtures and config files excluded).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/web/**", "src/**/*.test.ts", "src/**/test-fixtures.ts"]
}
